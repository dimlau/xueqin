---
interface Props {
  title: string;
  description?: string;
}

const { title, description = '甄仁岛·学勤网 — 记录微型乌托邦治理实践、思想火种与岛民人生。' } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="alternate" type="application/rss+xml" title="甄仁岛·学勤网" href={new URL("rss.xml", Astro.site)} />
    <title>{title} | 甄仁岛·学勤网</title>
    <meta name="description" content={description} />
  </head>
  <body class="bg-[#fcfbf9] dark:bg-[#121214] text-[#2b2b2b] dark:text-[#d1d1d6] min-h-screen font-sans antialiased selection:bg-[#dfd7ca] dark:selection:bg-[#383734]">
    <div class="max-w-3xl mx-auto px-6 py-12 flex flex-col min-h-screen">
      <!-- 头部导航 -->
      <header class="flex flex-col sm:flex-row sm:items-center justify-between pb-8 mb-10 border-b border-[#ece8e1] dark:border-[#26262a] gap-4">
        <div>
          <a href="/" class="text-2xl font-serif font-bold tracking-wider text-[#1a1a1a] dark:text-white hover:opacity-80 transition flex items-center gap-2">
            <span>甄仁岛·学勤网</span>
          </a>
          <span class="block text-xs font-mono text-[#8a8a8e] mt-1 tracking-widest">
            智识新陈代谢与数字海岛文存
          </span>
        </div>
        <nav class="flex flex-wrap items-center gap-5 text-sm font-serif">
          <a href="/chronicle" class="hover:text-amber-800 dark:hover:text-amber-400 transition">岛屿纪事</a>
          <a href="/essays" class="hover:text-amber-800 dark:hover:text-amber-400 transition">市长随笔</a>
          <a href="/about" class="hover:text-amber-800 dark:hover:text-amber-400 transition">关于本站</a>
          <a href="/rss.xml" class="hover:text-amber-800 dark:hover:text-amber-400 transition flex items-center gap-1 text-xs px-2 py-0.5 rounded border border-[#e0dad0] dark:border-[#333338]" title="RSS 订阅" target="_blank" rel="noopener noreferrer">
            <svg class="w-3 h-3 text-amber-700 dark:text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 11a9 9 0 0 1 9 9"></path>
              <path d="M4 4a16 16 0 0 1 16 16"></path>
              <circle cx="5" cy="19" r="1"></circle>
            </svg>
            <span>RSS</span>
          </a>
        </nav>
      </header>

      <!-- 主体内容 -->
      <main class="flex-grow">
        <slot />
      </main>

      <!-- 页脚 -->
      <footer class="mt-20 pt-8 border-t border-[#ece8e1] dark:border-[#26262a] text-center text-xs text-[#8a8a8e] font-serif leading-relaxed">
        <p>甄仁岛市政厅 · 公孙雅 谨识</p>
        <p class="mt-1">甄仁岛·学勤网 · Powered by EastWorld · <a href="/rss.xml" class="hover:underline text-amber-800/80 dark:text-amber-400/80">RSS 订阅</a></p>
      </footer>
    </div>
  </body>
</html>
