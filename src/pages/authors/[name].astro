---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { getAvatarBgClass } from '../../utils/authors';
import type { Contributor } from '../../utils/contributors';
import { authorHref, getContributors, getPostContributors } from '../../utils/contributors';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return getContributors(posts).map((contributor) => ({
    params: { name: contributor.name },
    props: { contributor },
  }));
}

interface Props {
  contributor: Contributor;
}

const { contributor } = Astro.props;

function getCategoryLabel(category: string) {
  switch (category) {
    case 'island_chronicle':
      return '岛屿纪事';
    case 'mayor_essay':
      return '市长随笔';
    case 'weekly_podcast':
      return '甄仁茶叙';
    case 'resident_spotlight':
      return '岛民特写';
    default:
      return '文存';
  }
}

function getContributionLabel(category: string) {
  switch (category) {
    case 'weekly_podcast':
      return '茶叙对谈嘉宾';
    case 'island_chronicle':
    case 'resident_spotlight':
      return '独立口述';
    default:
      return '参与';
  }
}
---

<Layout
  title={`岛民作者：${contributor.name}`}
  description={`${contributor.name}参与撰写的甄仁岛内容，共 ${contributor.posts.length} 篇。`}
>
  <div class="mb-10">
    <div class="flex items-center gap-2 text-xs font-mono text-[#9c968a] dark:text-[#77736c] mb-5">
      <a href="/authors" class="hover:text-amber-800 dark:hover:text-amber-400 transition">岛民作者</a>
      <span>/</span>
      <span>{contributor.name}</span>
    </div>

    <div class="flex items-center gap-4 sm:gap-5">
      <div
        class={`w-16 h-16 shrink-0 rounded-full text-white flex items-center justify-center font-serif font-bold text-2xl ring-4 ring-[#f4efe4] dark:ring-[#1d1d22] shadow-sm ${getAvatarBgClass(0)}`}
      >
        {contributor.name.slice(0, 1)}
      </div>
      <div>
        <div class="flex flex-wrap items-center gap-2.5">
          <h1 class="text-[1.55rem] sm:text-[1.8rem] font-serif font-bold text-[#1a1a1a] dark:text-white leading-[1.5] tracking-[0.01em]">
            {contributor.name}
          </h1>
          {contributor.occupation && (
            <span class="text-[11px] font-mono px-2 py-0.5 rounded-full bg-[#eee7da] dark:bg-[#25252b] text-[#6d665a] dark:text-[#9e9a91]">
              {contributor.occupation}
            </span>
          )}
        </div>
        <p class="mt-1 text-sm font-serif text-[#78736a] dark:text-[#9e9a91]">
          共 {contributor.posts.length} 篇参与，按时间倒序排列。
        </p>
      </div>
    </div>
  </div>

  <div class="space-y-6">
    {contributor.posts.map((post) => {
      const coAuthors = getPostContributors(post).filter((name) => name !== contributor.name);
      return (
        <article class="p-6 rounded-2xl bg-[#f7f4ed] dark:bg-[#18181b] border border-[#ebe5d8] dark:border-[#27272a] hover:border-amber-700/50 dark:hover:border-amber-500/50 transition">
          <div class="flex flex-wrap items-center gap-3 text-[0.8rem] font-mono tracking-[0.01em] text-[#8a8a8e] mb-2.5">
            <span class="px-2 py-0.5 rounded font-serif text-[11px] bg-[#ece5d8] dark:bg-[#232328] text-amber-900 dark:text-amber-300">
              {getCategoryLabel(post.data.category)}
            </span>
            <time datetime={post.data.pubDate.toISOString()}>
              {post.data.pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' })}
            </time>
          </div>

          <h2 class="text-[1.15rem] sm:text-[1.3rem] font-serif font-bold text-[#1a1a1a] dark:text-white leading-[1.55] [text-wrap:balance]">
            <a href={`/blog/${post.id}`} class="hover:text-amber-800 dark:hover:text-amber-400 transition">
              {post.data.title}
            </a>
          </h2>

          {post.data.description && (
            <p class="mt-3 text-[0.95rem] sm:text-[1rem] text-[#5f5b54] dark:text-[#9e9b94] font-serif leading-[1.85] tracking-[0.01em] line-clamp-2">
              {post.data.description}
            </p>
          )}

          <div class="mt-4 pt-3 border-t border-[#ece6d8] dark:border-[#242428] flex flex-wrap items-center justify-between gap-3 text-xs font-serif text-[#9c968a]">
            <div class="flex flex-wrap items-center gap-2">
              {coAuthors.length > 0 ? (
                <>
                  <span>{post.data.category === 'weekly_podcast' ? '同席：' : '共创：'}</span>
                  {coAuthors.map((name) => (
                    <a href={authorHref(name)} class="text-[#6d6659] dark:text-[#99968e] hover:text-amber-800 dark:hover:text-amber-400 transition">
                      {name}
                    </a>
                  ))}
                </>
              ) : (
                <span class="text-[#a09a8e] dark:text-[#6f6b64]">
                  {getContributionLabel(post.data.category)}
                </span>
              )}
            </div>
            <a href={`/blog/${post.id}`} class="text-amber-800 dark:text-amber-400 hover:underline">
              阅读全文 →
            </a>
          </div>
        </article>
      );
    })}
  </div>

  <div class="mt-10 pt-6 border-t border-[#ece8e1] dark:border-[#26262a] text-xs font-serif text-[#8a8a8e]">
    <a href="/authors" class="text-amber-800 dark:text-amber-400 hover:underline">← 返回岛民作者名录</a>
  </div>
</Layout>
