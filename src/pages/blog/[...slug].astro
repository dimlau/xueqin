---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

function getCategoryLabel(category: string) {
  switch (category) {
    case 'resident_spotlight':
      return '岛民一日 · 特约共创';
    case 'governance':
      return '治岛手记';
    case 'reading_digest':
      return '窗外阅影 · 读书札记';
    case 'dialogue':
      return '神隐对谈 · 哲学思辨';
    default:
      return '随笔';
  }
}
---

<Layout title={post.data.title} description={post.data.description}>
  <article class="max-w-none">
    <!-- 文章头部 -->
    <header class="pb-8 mb-10 border-b border-[#ece8e1] dark:border-[#26262a]">
      <div class="flex flex-wrap items-center gap-3 text-xs font-mono text-[#8a8a8e] mb-4">
        <time datetime={post.data.pubDate.toISOString()}>
          {post.data.pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' })}
        </time>
        <span>·</span>
        <span class="px-2 py-0.5 rounded bg-[#f4efe6] dark:bg-[#1f1f24] text-[#736b5e] dark:text-[#a09e99]">
          {getCategoryLabel(post.data.category)}
        </span>
        {post.data.island_epoch && (
          <>
            <span>·</span>
            <span>{post.data.island_epoch}</span>
          </>
        )}
      </div>

      <h1 class="text-2xl sm:text-4xl font-serif font-bold text-[#1a1a1a] dark:text-white leading-tight">
        {post.data.title}
      </h1>

      <!-- 岛民共创特约卡片 -->
      {post.data.guest_author && post.data.resident_snapshot && (
        <div class="mt-6 p-4 rounded-xl bg-[#f7f4ed] dark:bg-[#1c1c20] border border-[#e8e2d5] dark:border-[#2e2e36] flex items-center justify-between">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-amber-800 text-white flex items-center justify-center font-serif font-bold text-base">
              {post.data.guest_author.slice(0, 1)}
            </div>
            <div>
              <div class="text-sm font-serif font-bold text-[#2a2723] dark:text-[#f0ede6]">
                本期特约主笔：{post.data.guest_author}
              </div>
              <div class="text-xs text-[#7d776c] dark:text-[#9e998e] mt-0.5">
                {post.data.resident_snapshot.occupation || '岛民'} · {post.data.resident_snapshot.mbti || '居民'}
              </div>
            </div>
          </div>
          <div class="text-xs font-serif text-amber-900 dark:text-amber-300 px-3 py-1 bg-amber-100/60 dark:bg-amber-950/40 rounded-full">
            共创专栏
          </div>
        </div>
      )}
    </header>

    <!-- 正文渲染 -->
    <div class="prose prose-neutral dark:prose-invert prose-stone font-serif max-w-none prose-headings:font-serif prose-headings:font-bold prose-blockquote:border-amber-800/40 prose-blockquote:bg-[#fbf9f5] dark:prose-blockquote:bg-[#18181b] prose-blockquote:py-2 prose-blockquote:px-5 prose-blockquote:rounded-r-lg prose-blockquote:not-italic prose-p:leading-relaxed prose-p:text-[#383531] dark:prose-p:text-[#cfccc6]">
      <Content />
    </div>

    <!-- 文章尾部标签 -->
    <footer class="mt-16 pt-8 border-t border-[#ece8e1] dark:border-[#26262a]">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div class="flex items-center gap-2">
          {post.data.tags.map((tag) => (
            <span class="text-xs font-serif px-2.5 py-1 rounded bg-[#f4efe6] dark:bg-[#1f1f24] text-[#6d6659] dark:text-[#99968e]">
              #{tag}
            </span>
          ))}
        </div>
        <a href="/" class="text-xs font-serif text-amber-800 dark:text-amber-400 hover:underline">
          ← 返回文存目录
        </a>
      </div>
    </footer>
  </article>
</Layout>
