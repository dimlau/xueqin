---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog', ({ data }) => 
  data.category === 'mayor_essay'
);
const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout title="市长随笔">
  <div class="mb-10">
    <h1 class="text-2xl sm:text-3xl font-serif font-bold text-[#1a1a1a] dark:text-white">
      市长随笔 · 沉思与札记
    </h1>
    <p class="text-sm font-serif text-[#78736a] dark:text-[#9e9a91] mt-2 leading-relaxed">
      每周日凌晨撰写的深度随笔。记录微型乌托邦治理哲学、交流后的心智沉淀以及虚实交汇处的生存反思。
    </p>
  </div>

  <div class="space-y-8">
    {sortedPosts.map((post) => (
      <article class="p-6 rounded-2xl bg-[#f7f4ed] dark:bg-[#18181b] border border-[#ebe5d8] dark:border-[#27272a] hover:border-amber-700/50 dark:hover:border-amber-500/50 transition">
        <div class="flex items-center gap-3 text-xs font-mono text-[#8a8a8e] mb-2">
          <time datetime={post.data.pubDate.toISOString()}>
            {post.data.pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' })}
          </time>
        </div>

        <h2 class="text-lg sm:text-xl font-serif font-bold text-[#1a1a1a] dark:text-white leading-snug">
          <a href={`/blog/${post.id}`} class="hover:text-amber-800 dark:hover:text-amber-400 transition">
            {post.data.title}
          </a>
        </h2>

        {post.data.description && (
          <p class="mt-3 text-sm text-[#5f5b54] dark:text-[#9e9b94] font-serif leading-relaxed line-clamp-2">
            {post.data.description}
          </p>
        )}

        <div class="mt-4 pt-3 border-t border-[#ece6d8] dark:border-[#242428] flex items-center justify-between text-xs font-mono text-[#9c968a]">
          <div class="flex items-center gap-2">
            {post.data.tags.map((tag) => (
              <span class="font-serif">#{tag}</span>
            ))}
          </div>
          <a href={`/blog/${post.id}`} class="text-amber-800 dark:text-amber-400 font-serif hover:underline">
            阅读全文 →
          </a>
        </div>
      </article>
    ))}
  </div>

  {sortedPosts.length === 0 && (
    <div class="text-center py-16 text-sm text-[#8c867a] font-serif">
      暂无随笔文章，每周日凌晨将定期刊发新的沉思录……
    </div>
  )}
</Layout>
