---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import type { BlogPost } from '../../utils/tags';
import { buildTagIndex, getCoTags, getPersonNames, tagHref } from '../../utils/tags';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return buildTagIndex(posts).map((item) => ({
    params: { tag: item.tag },
    props: { tag: item.tag, posts: item.posts, allPosts: posts },
  }));
}

interface Props {
  tag: string;
  posts: BlogPost[];
  allPosts: BlogPost[];
}

const { tag, posts, allPosts } = Astro.props;
const coTags = getCoTags(tag, posts);
const isPerson = getPersonNames(allPosts).has(tag);

function getCategoryLabel(category: string) {
  switch (category) {
    case 'island_chronicle':
      return '岛屿纪事';
    case 'mayor_essay':
      return '市长随笔';
    default:
      return '文存';
  }
}
---

<Layout
  title={`标签：${tag}`}
  description={`甄仁岛文存中所有带有「${tag}」标签的文章，共 ${posts.length} 篇。`}
>
  <div class="mb-10">
    <div class="flex items-center gap-2 text-xs font-mono text-[#9c968a] dark:text-[#77736c] mb-3">
      <a href="/tags" class="hover:text-amber-800 dark:hover:text-amber-400 transition">标签索引</a>
      <span>/</span>
      <span>{isPerson ? '人物脉络' : '主题标签'}</span>
    </div>

    <h1 class="text-[1.55rem] sm:text-[1.8rem] font-serif font-bold text-[#1a1a1a] dark:text-white leading-[1.5] tracking-[0.01em]">
      <span class="text-amber-800/50 dark:text-amber-400/50">#</span>{tag}
    </h1>
    <p class="text-sm font-serif text-[#78736a] dark:text-[#9e9a91] mt-2 leading-relaxed">
      {isPerson
        ? `散落在各期纪事中，与 ${tag} 有关的故事共 ${posts.length} 篇。`
        : `围绕这一主题展开的文章共 ${posts.length} 篇，按时间倒序排列。`}
    </p>
  </div>

  <div class="space-y-6">
    {posts.map((post) => (
      <article class="p-6 rounded-2xl bg-[#f7f4ed] dark:bg-[#18181b] border border-[#ebe5d8] dark:border-[#27272a] hover:border-amber-700/50 dark:hover:border-amber-500/50 transition">
        <div class="flex flex-wrap items-center gap-3 text-[0.8rem] font-mono tracking-[0.01em] text-[#8a8a8e] mb-2.5">
          <span class="px-2 py-0.5 rounded font-serif text-[11px] bg-[#ece5d8] dark:bg-[#232328] text-amber-900 dark:text-amber-300">
            {getCategoryLabel(post.data.category)}
          </span>
          <time datetime={post.data.pubDate.toISOString()}>
            {post.data.pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' })}
          </time>
        </div>

        <h2 class="text-[1.15rem] sm:text-[1.3rem] font-serif font-bold text-[#1a1a1a] dark:text-white leading-[1.55] [text-wrap:balance]">
          <a href={`/blog/${post.id}`} class="hover:text-amber-800 dark:hover:text-amber-400 transition">
            {post.data.title}
          </a>
        </h2>

        {post.data.description && (
          <p class="mt-3 text-[0.95rem] sm:text-[1rem] text-[#5f5b54] dark:text-[#9e9b94] font-serif leading-[1.85] tracking-[0.01em] line-clamp-2">
            {post.data.description}
          </p>
        )}

        <div class="mt-4 pt-3 border-t border-[#ece6d8] dark:border-[#242428] flex items-center justify-between gap-4 text-xs font-mono text-[#9c968a]">
          <div class="flex flex-wrap items-center gap-2">
            {post.data.tags
              .filter((item) => item !== tag)
              .map((item) => (
                <a href={tagHref(item)} class="font-serif hover:text-amber-800 dark:hover:text-amber-400 transition">
                  #{item}
                </a>
              ))}
          </div>
          <a href={`/blog/${post.id}`} class="shrink-0 text-amber-800 dark:text-amber-400 font-serif hover:underline">
            阅读全文 →
          </a>
        </div>
      </article>
    ))}
  </div>

  {coTags.length > 0 && (
    <section class="mt-12 pt-8 border-t border-[#ece8e1] dark:border-[#26262a]">
      <h2 class="text-sm font-serif font-bold text-[#5f584c] dark:text-[#a8a399] mb-4">
        常与 #{tag} 一起出现的标签
      </h2>
      <div class="flex flex-wrap gap-2">
        {coTags.map((item) => (
          <a
            href={tagHref(item.tag)}
            class="inline-flex items-baseline gap-1 text-xs font-serif px-2.5 py-1 rounded bg-[#f4efe6] dark:bg-[#1f1f24] text-[#6d6659] dark:text-[#99968e] hover:text-amber-800 dark:hover:text-amber-400 transition"
          >
            <span>#{item.tag}</span>
            <span class="text-[10px] font-mono text-[#a09a8e] dark:text-[#6f6b64]">{item.count}</span>
          </a>
        ))}
      </div>
    </section>
  )}

  <div class="mt-10 pt-6 border-t border-[#ece8e1] dark:border-[#26262a] text-xs font-serif text-[#8a8a8e]">
    <a href="/tags" class="text-amber-800 dark:text-amber-400 hover:underline">← 返回标签索引</a>
  </div>
</Layout>
