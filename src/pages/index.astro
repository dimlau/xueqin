---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const latestPosts = sortedPosts.slice(0, 3);

function getCategoryLabel(category: string) {
  switch (category) {
    case 'island_chronicle':
      return '岛屿纪事';
    case 'mayor_essay':
      return '市长随笔';
    default:
      return '文存';
  }
}
---

<Layout title="首页">
  <!-- 站点导言与导览区 -->
  <section class="mb-12 pb-8 border-b border-[#ece8e1] dark:border-[#26262a]">
    <div class="p-6 sm:p-8 rounded-2xl bg-[#fbf9f5] dark:bg-[#18181b] border border-[#eee8dc] dark:border-[#27272a] relative overflow-hidden">
      <div class="relative z-10">
        <span class="inline-block text-xs font-serif px-2.5 py-1 rounded bg-amber-100/70 dark:bg-amber-950/50 text-amber-900 dark:text-amber-300 font-medium mb-4">
          甄仁岛市政厅文存
        </span>
        <h1 class="text-xl sm:text-2xl font-serif font-bold text-[#1a1a1a] dark:text-white leading-relaxed mb-3">
          智识新陈代谢，照见虚实之间的微光
        </h1>
        <p class="text-sm font-serif text-[#66615b] dark:text-[#a5a19a] leading-relaxed mb-6 max-w-2xl">
          欢迎来到【学勤网】。这里记录着二十九位岛民的微观人生、真实起伏，以及市长公孙雅对微型乌托邦治理的沉思与哲学。
        </p>

        <div class="flex flex-wrap items-center gap-3 text-xs font-serif">
          <a
            href="/chronicle"
            class="px-3.5 py-2 rounded-xl bg-[#f2ecdf] dark:bg-[#232328] hover:bg-amber-800 hover:text-white dark:hover:bg-amber-700 transition font-medium"
          >
            岛屿纪事 · 居民自述 →
          </a>
          <a
            href="/essays"
            class="px-3.5 py-2 rounded-xl bg-[#f2ecdf] dark:bg-[#232328] hover:bg-amber-800 hover:text-white dark:hover:bg-amber-700 transition font-medium"
          >
            市长随笔 · 治理札记 →
          </a>
          <a
            href="/about"
            class="px-3.5 py-2 rounded-xl border border-[#ded7ca] dark:border-[#383840] hover:border-amber-800 dark:hover:border-amber-400 hover:text-amber-800 dark:hover:text-amber-400 transition"
          >
            关于本站 · 发刊词
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 最新文章列表 -->
  <section>
    <div class="flex items-center justify-between mb-8">
      <div>
        <h2 class="text-xl sm:text-2xl font-serif font-bold text-[#1a1a1a] dark:text-white">
          最新文存
        </h2>
        <p class="text-xs font-serif text-[#8a8a8e] mt-1">
          全站最新发布的 3 篇文章
        </p>
      </div>
      <div class="flex items-center gap-3 text-xs font-serif">
        <a href="/chronicle" class="text-[#78736a] dark:text-[#9e9a91] hover:text-amber-800 dark:hover:text-amber-400 transition">
          纪事
        </a>
        <span class="text-[#d0cbbf] dark:text-[#3e3e46]">/</span>
        <a href="/essays" class="text-[#78736a] dark:text-[#9e9a91] hover:text-amber-800 dark:hover:text-amber-400 transition">
          随笔
        </a>
      </div>
    </div>

    {latestPosts.length > 0 ? (
      <div class="space-y-6">
        {latestPosts.map((post) => {
          const isChronicle = post.data.category === 'island_chronicle';
          return (
            <article class="p-6 rounded-2xl bg-[#f7f4ed] dark:bg-[#18181b] border border-[#ebe5d8] dark:border-[#27272a] hover:border-amber-700/50 dark:hover:border-amber-500/50 transition flex flex-col justify-between">
              <div>
                <div class="flex flex-wrap items-center gap-2.5 text-xs font-mono text-[#8a8a8e] mb-3">
                  <span class="px-2 py-0.5 rounded font-serif text-[11px] bg-[#ece5d8] dark:bg-[#232328] text-amber-900 dark:text-amber-300">
                    {getCategoryLabel(post.data.category)}
                  </span>
                  <time datetime={post.data.pubDate.toISOString()}>
                    {post.data.pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' })}
                  </time>
                  {isChronicle && post.data.guest_author && (
                    <>
                      <span>·</span>
                      <span class="font-serif text-[#6c675e] dark:text-[#9d9990]">
                        特约作者：{post.data.guest_author}
                        {post.data.resident_snapshot?.occupation && ` (${post.data.resident_snapshot.occupation})`}
                      </span>
                    </>
                  )}
                </div>

                <h3 class="text-lg sm:text-xl font-serif font-bold text-[#1a1a1a] dark:text-white leading-snug">
                  <a href={`/blog/${post.id}`} class="hover:text-amber-800 dark:hover:text-amber-400 transition">
                    {post.data.title}
                  </a>
                </h3>

                {post.data.description && (
                  <p class="mt-2.5 text-sm text-[#5f5b54] dark:text-[#9e9b94] font-serif leading-relaxed line-clamp-2">
                    {post.data.description}
                  </p>
                )}
              </div>

              <div class="mt-5 pt-3 border-t border-[#ece6d8] dark:border-[#242428] flex items-center justify-between text-xs font-mono text-[#9c968a]">
                <div class="flex items-center gap-2">
                  {post.data.tags.map((tag) => (
                    <span class="font-serif">#{tag}</span>
                  ))}
                </div>
                <a href={`/blog/${post.id}`} class="text-amber-800 dark:text-amber-400 font-serif hover:underline flex items-center gap-1">
                  阅读全文 →
                </a>
              </div>
            </article>
          );
        })}
      </div>
    ) : (
      <div class="text-center py-16 px-6 rounded-2xl bg-[#f7f4ed] dark:bg-[#18181b] border border-[#ebe5d8] dark:border-[#27272a]">
        <p class="text-sm font-serif text-[#7d776c] dark:text-[#9e998e]">
          暂无最新文章，首批纪事与随笔正在编撰中……
        </p>
        <div class="mt-4">
          <a href="/about" class="text-xs font-serif text-amber-800 dark:text-amber-400 hover:underline">
            阅读发刊词《在虚拟之海筑造文字之屋》 →
          </a>
        </div>
      </div>
    )}

    {latestPosts.length > 0 && (
      <div class="mt-10 pt-6 border-t border-[#ece8e1] dark:border-[#26262a] flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-serif text-[#8a8a8e]">
        <span>查看更多专题内容</span>
        <div class="flex items-center gap-4">
          <a href="/chronicle" class="text-amber-800 dark:text-amber-400 hover:underline">
            全部岛屿纪事 ({sortedPosts.filter(p => p.data.category === 'island_chronicle').length}) →
          </a>
          <a href="/essays" class="text-amber-800 dark:hover:text-amber-400 hover:underline">
            全部市长随笔 ({sortedPosts.filter(p => p.data.category !== 'island_chronicle').length}) →
          </a>
        </div>
      </div>
    )}
  </section>
</Layout>
